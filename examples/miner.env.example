# Required model-provider credential.
OPENROUTER_API_KEY=
# Chutes is also supported through its OpenAI-compatible API. To use it, set
# this key and change the provider/model settings below to Chutes values.
# CHUTES_API_KEY=
# CHUTES_API_BASE=https://llm.chutes.ai/v1

# Persistent Hermes defaults written by the installer. Miner command flags can override the model.
HERMES_PROVIDER=openrouter
HERMES_MODEL=deepseek/deepseek-v4-flash
HERMES_BASE_URL=https://openrouter.ai/api/v1
# Chutes example:
# HERMES_PROVIDER=chutes
# HERMES_MODEL=deepseek-ai/DeepSeek-V3.2-TEE
# HERMES_BASE_URL=https://llm.chutes.ai/v1

# Used by the container entrypoint. Change these to the registered miner wallet.
BT_WALLET_NAME=claims-test-miner
BT_WALLET_HOTKEY=default
BT_NETUID=530
BT_SUBTENSOR_NETWORK=test

# Testnet 530 miner defaults.
CLAIMS_BACKEND_URL=https://artifacts.claims111.ai
CLAIMS_BACKEND_TIMEOUT=120
CLAIMS_BACKEND_RETRIES=3
CLAIMS_MINER_BATCH_MAX_WORKERS=2
SUBNET_CLAIMS_PDF_READER=pdf-inspector
SUBNET_CLAIMS_AGENT_PROVIDER=openrouter
SUBNET_CLAIMS_AGENT_MODEL=deepseek/deepseek-v4-flash
# Chutes example:
# SUBNET_CLAIMS_AGENT_PROVIDER=chutes
# SUBNET_CLAIMS_AGENT_MODEL=deepseek-ai/DeepSeek-V3.2-TEE
# Some Chutes non-streaming models reject completion caps above 8192.
# SUBNET_CLAIMS_AGENT_MAX_TOKENS=8192
SUBNET_CLAIMS_AGENT_TIMEOUT=3600
SUBNET_CLAIMS_CONSENSUS_MODE=model
# Consensus uses structured DSPy calls. These settings can select a different
# provider/model from extraction; when omitted they inherit SUBNET_CLAIMS_AGENT_*.
# SUBNET_CLAIMS_CONSENSUS_PROVIDER=openrouter
# SUBNET_CLAIMS_CONSENSUS_MODEL=deepseek/deepseek-v4-flash
# SUBNET_CLAIMS_CONSENSUS_API_BASE=https://openrouter.ai/api/v1
# SUBNET_CLAIMS_CONSENSUS_API_KEY_ENV=OPENROUTER_API_KEY
SUBNET_CLAIMS_CONSENSUS_MAX_TOKENS=8192
SUBNET_CLAIMS_CONSENSUS_TIMEOUT=1800
SUBNET_CLAIMS_CONSENSUS_BATCH_SIZE=2
SUBNET_CLAIMS_CONSENSUS_MAX_WORKERS=4
SUBNET_CLAIMS_CONSENSUS_SOURCE_MAX_WORKERS=4
# Bounds source serialized into native DSPy/LangChain extraction prompts.
# File-agent harnesses receive the complete source file path instead.
SUBNET_CLAIMS_AGENT_MAX_EXTRACTION_SOURCE_CHARS=60000
