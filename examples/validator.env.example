# Required model-provider credential.
OPENROUTER_API_KEY=
# Chutes is also supported through its OpenAI-compatible API. To use it, set
# this key and change each relevant provider setting below to chutes.
# CHUTES_API_KEY=
# CHUTES_API_BASE=https://llm.chutes.ai/v1
# Native DSPy rigor with Chutes also uses:
# CLAIMS_RIGOR_API_BASE=https://llm.chutes.ai/v1
# CLAIMS_RIGOR_API_KEY_ENV=CHUTES_API_KEY
# DSPy Silver adjudication uses:
# CLAIMS_SILVER_ADJUDICATION_API_BASE=https://llm.chutes.ai/v1
# CLAIMS_SILVER_ADJUDICATION_API_KEY_ENV=CHUTES_API_KEY

# Persistent Hermes defaults written by the installer. Runtime stage settings can override the model.
HERMES_PROVIDER=openrouter
HERMES_MODEL=deepseek/deepseek-v4-flash
HERMES_BASE_URL=https://openrouter.ai/api/v1

# Testnet 530 validator defaults.
CLAIMS_NETWORK=testnet
CLAIMS_BACKEND_URL=https://api.claims111.ai
CLAIMS_BRONZE_ROOT=validator/agent_v1/bronze/production
CLAIMS_OUTPUT_DIR=validator/agent_v1/outputs/neuron/production
# Keep the newest five local run outputs; Bronze is retained separately.
CLAIMS_OUTPUT_RETENTION_RUNS=5
CLAIMS_BATCH_SIZE=50
# Temporarily reuse approved papers while the production catalog is still growing.
CLAIMS_ALLOW_PAPER_REUSE=true
CLAIMS_MINER_SELECTION_MODE=adaptive
# Total miners per run; adaptive lanes use a 40/40/20 split.
CLAIMS_MINER_SAMPLE_SIZE=15
# Read the current subnet immunity period from chain; 7200 blocks is about 24 hours.
CLAIMS_MINER_IMMUNITY_PERIOD_BLOCKS=0
CLAIMS_MINER_IMMUNITY_PRIORITY_BLOCKS=7200
# Exclude miners for about 24 hours after their latest evaluation scores zero.
CLAIMS_MINER_ZERO_SCORE_COOLDOWN_BLOCKS=7200
# Reject Axons within 1024 IPv4 addresses of a selected Axon; IPv6 is grouped by /64.
CLAIMS_MINER_IPV4_PROXIMITY_ADDRESSES=1024
CLAIMS_MINER_IPV6_PREFIX_BITS=64
CLAIMS_TIMEOUT=3600
# Follower validators poll for canonical batch artifacts instead of querying the same miners again.
CLAIMS_BATCH_COLLECTION_POLL_SECONDS=5
CLAIMS_BATCH_COLLECTION_WAIT_SECONDS=3900
CLAIMS_MAX_STEPS=4
CLAIMS_AUDIT_ONLY=false
CLAIMS_QUERY_INTERVAL=10800
CLAIMS_VALIDATOR_PIPELINE=auto
CLAIMS_AUDIT_METHOD=llm
CLAIMS_AGENT_V1_VALIDATION_MODE=llm
CLAIMS_BATCH_SCORE_RULE=mean
CLAIMS_PAYOUT_MODE=winner-takes-most

CLAIMS_RIGOR_HARNESS=hermes-cli
CLAIMS_RIGOR_PROVIDER=openrouter
CLAIMS_RIGOR_MODEL=deepseek/deepseek-v4-flash
CLAIMS_DIAGNOSTIC_MINER_BATCH_SIZE=10
CLAIMS_DIAGNOSTIC_MAX_WORKERS=10

CLAIMS_REFERENCE_MINER_COMMAND=python -m claims_reference_miner
CLAIMS_REFERENCE_MINER_HARNESS=hermes-cli
CLAIMS_REFERENCE_MINER_PROVIDER=openrouter
CLAIMS_REFERENCE_MINER_MODEL=openai/gpt-5.6-luna-pro
CLAIMS_REFERENCE_PROFILE_ID=reference-agent-v1-hermes
CLAIMS_REFERENCE_MINER_PDF_READER=pdf-inspector

CLAIMS_SILVER_ENABLE=true
CLAIMS_SILVER_WORKFLOW_MODE=file-agent
CLAIMS_SILVER_ADJUDICATION_HARNESS=hermes-cli
CLAIMS_SILVER_ADJUDICATION_CLI_PROVIDER=openrouter
CLAIMS_SILVER_ADJUDICATION_MAX_IN_FLIGHT=32
CLAIMS_SILVER_MAX_ELIGIBLE_CLAIMS_PER_MINER=6
CLAIMS_SILVER_MAX_ADJUDICATION_CASES_PER_PAPER=80
CLAIMS_SILVER_FILTER_BY_ASSESSMENT=false
CLAIMS_SILVER_FILE_AGENT_HARNESS=hermes-cli
CLAIMS_SILVER_FILE_AGENT_PROVIDER=openrouter
CLAIMS_SILVER_FILE_AGENT_COMPARISON_MODEL=deepseek/deepseek-v4-flash
CLAIMS_SILVER_FILE_AGENT_CANONICALIZATION_MODEL=deepseek/deepseek-v4-flash
CLAIMS_SILVER_FILE_AGENT_CANONICAL_AUDIT_MODEL=qwen/qwen3.7-flash
CLAIMS_SILVER_FILE_AGENT_REQUIRE_DISTINCT_JUDGES=true
CLAIMS_SILVER_FILE_AGENT_FALLBACK=none
CLAIMS_SILVER_ADJUDICATION_MODEL_A=deepseek/deepseek-v4-flash
CLAIMS_SILVER_ADJUDICATION_MODEL_B=qwen/qwen3.7-flash
CLAIMS_SILVER_ADJUDICATION_TIEBREAK_MODEL=deepseek/deepseek-v4-flash
CLAIMS_SILVER_PAPER_MAX_WORKERS=50
