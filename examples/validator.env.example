# Required model-provider credential.
OPENROUTER_API_KEY=

# Testnet 530 validator defaults. Start in audit-only mode.
CLAIMS_NETWORK=testnet
CLAIMS_BACKEND_URL=https://apiclaims-eight.vercel.app
CLAIMS_BATCH_SIZE=5
CLAIMS_TIMEOUT=1800
CLAIMS_MAX_STEPS=1
CLAIMS_AUDIT_ONLY=true

CLAIMS_RIGOR_HARNESS=hermes-cli
CLAIMS_RIGOR_PROVIDER=openrouter
CLAIMS_RIGOR_MODEL=deepseek/deepseek-v4-flash
CLAIMS_DIAGNOSTIC_MINER_BATCH_SIZE=10
CLAIMS_DIAGNOSTIC_MAX_WORKERS=5

CLAIMS_REFERENCE_MINER_COMMAND=python -m claims_reference_miner
CLAIMS_REFERENCE_MINER_HARNESS=hermes-cli
CLAIMS_REFERENCE_MINER_MODEL=openai/gpt-5.6-luna-pro
CLAIMS_REFERENCE_MINER_PDF_READER=pdf-inspector

CLAIMS_SILVER_ENABLE=true
CLAIMS_SILVER_WORKFLOW_MODE=file-agent
CLAIMS_SILVER_FILE_AGENT_HARNESS=hermes-cli
CLAIMS_SILVER_FILE_AGENT_PROVIDER=openrouter
CLAIMS_SILVER_FILE_AGENT_COMPARISON_MODEL=deepseek/deepseek-v4-flash
CLAIMS_SILVER_FILE_AGENT_CANONICALIZATION_MODEL=deepseek/deepseek-v4-flash
CLAIMS_SILVER_FILE_AGENT_CANONICAL_AUDIT_MODEL=qwen/qwen3.7-flash
CLAIMS_SILVER_ADJUDICATION_MODEL_A=deepseek/deepseek-v4-flash
CLAIMS_SILVER_ADJUDICATION_MODEL_B=qwen/qwen3.7-flash
CLAIMS_SILVER_ADJUDICATION_TIEBREAK_MODEL=deepseek/deepseek-v4-flash
CLAIMS_SILVER_PAPER_MAX_WORKERS=5
