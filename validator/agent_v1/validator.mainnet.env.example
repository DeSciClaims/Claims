# Claims SN111 mainnet validator profile: four scheduled 50-paper cycles against
# fifteen adaptively selected miners. Choose provider credentials and independent
# models for every blank role before running.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Alternative OpenAI-compatible provider; see the validator README.
# CHUTES_API_KEY=
# CHUTES_API_BASE=https://llm.chutes.ai/v1

# Used by the container entrypoint. Manual neuron commands may pass these as flags.
BT_WALLET_NAME=
BT_WALLET_HOTKEY=default
BT_NETUID=111
BT_SUBTENSOR_NETWORK=finney

# Hermes defaults. The model is intentionally not prescribed for mainnet.
HERMES_PROVIDER=openrouter
HERMES_MODEL=
HERMES_BASE_URL=https://openrouter.ai/api/v1

# Batch and scoring schedule.
CLAIMS_NETWORK=mainnet
CLAIMS_BACKEND_URL=https://api.claims111.ai
CLAIMS_BRONZE_ROOT=validator/agent_v1/bronze/production
CLAIMS_OUTPUT_DIR=validator/agent_v1/outputs/neuron/mainnet
# Keep the newest five local run outputs; Bronze is retained separately.
CLAIMS_OUTPUT_RETENTION_RUNS=5
CLAIMS_BATCH_SIZE=50
# Temporarily reuse approved papers while the production catalog is still growing.
CLAIMS_ALLOW_PAPER_REUSE=true
CLAIMS_MINER_SELECTION_MODE=adaptive
# Total miners per run; adaptive lanes use a 40/40/20 split.
CLAIMS_MINER_SAMPLE_SIZE=15
# Read the current subnet immunity period from chain; 7200 blocks is about 24 hours.
CLAIMS_MINER_IMMUNITY_PERIOD_BLOCKS=0
CLAIMS_MINER_IMMUNITY_PRIORITY_BLOCKS=7200
# Exclude miners for about 24 hours after their latest evaluation scores zero.
CLAIMS_MINER_ZERO_SCORE_COOLDOWN_BLOCKS=7200
# Reject Axons within 1024 IPv4 addresses of a selected Axon; IPv6 is grouped by /64.
CLAIMS_MINER_IPV4_PROXIMITY_ADDRESSES=1024
CLAIMS_MINER_IPV6_PREFIX_BITS=64
# Setting CLAIMS_TARGET_UIDS disables adaptive selection and uses exactly that list.
CLAIMS_VALIDATOR_PIPELINE=auto
CLAIMS_AUDIT_METHOD=llm
CLAIMS_AGENT_V1_VALIDATION_MODE=llm
CLAIMS_AGENT_V1_THRESHOLD=0.0
CLAIMS_BATCH_SCORE_RULE=mean
CLAIMS_PAYOUT_MODE=winner-takes-most
CLAIMS_TIMEOUT=3600
CLAIMS_BATCH_COLLECTION_POLL_SECONDS=5
CLAIMS_BATCH_COLLECTION_WAIT_SECONDS=3900
CLAIMS_MAX_STEPS=4
CLAIMS_AUDIT_ONLY=false
CLAIMS_QUERY_INTERVAL=10800

# Diagnostic validation: select an independent model before launch.
CLAIMS_RIGOR_HARNESS=hermes-cli
CLAIMS_RIGOR_PROVIDER=openrouter
CLAIMS_RIGOR_MODEL=
CLAIMS_RIGOR_MAX_TURNS=30
SUBNET_CLAIMS_VALIDATOR_AGENT_MAX_TOKENS=16384
CLAIMS_DIAGNOSTIC_MINER_MAX_WORKERS=2
CLAIMS_DIAGNOSTIC_MAX_WORKERS=10
CLAIMS_DIAGNOSTIC_MINER_BATCH_SIZE=10

# Bronze reference generation: select an independent model before launch.
CLAIMS_REFERENCE_MINER_COMMAND=python -m claims_reference_miner
CLAIMS_REFERENCE_MINER_HARNESS=hermes-cli
CLAIMS_REFERENCE_MINER_PROVIDER=openrouter
CLAIMS_REFERENCE_MINER_MODEL=
CLAIMS_REFERENCE_PROFILE_ID=reference-agent-v1-hermes
CLAIMS_REFERENCE_MINER_PDF_READER=pdf-inspector

# Silver candidate pairing. Select an embedding model if this mode is enabled.
CLAIMS_SILVER_ENABLE=true
CLAIMS_SILVER_PAIRING_TOP_K=4
CLAIMS_SILVER_PAIRING_MAX_DENSE_PAIRS=0
CLAIMS_SILVER_PAIRING_EMBEDDING_MODE=openrouter
CLAIMS_SILVER_PAIRING_EMBEDDING_MODEL=

# Anonymous direct judges and conditional tiebreaker. Choose diverse models.
CLAIMS_SILVER_ADJUDICATION_HARNESS=hermes-cli
CLAIMS_SILVER_ADJUDICATION_CLI_PROVIDER=openrouter
CLAIMS_SILVER_ADJUDICATION_MODEL_A=
CLAIMS_SILVER_ADJUDICATION_MODEL_B=
CLAIMS_SILVER_ADJUDICATION_TIEBREAK_MODEL=
CLAIMS_SILVER_ADJUDICATION_CLI_TIMEOUT=1800
CLAIMS_SILVER_ADJUDICATION_CLI_MAX_TURNS=30
CLAIMS_SILVER_ADJUDICATION_MAX_IN_FLIGHT=32
CLAIMS_SILVER_ADJUDICATION_MAX_TOKENS=81920
CLAIMS_SILVER_ADJUDICATION_BATCH_INPUT_TOKENS=120000
CLAIMS_SILVER_ADJUDICATION_BATCH_SIZE=13
CLAIMS_SILVER_ADJUDICATION_MAX_WORKERS=9
CLAIMS_SILVER_ADJUDICATION_CLI_PROMPT_MODE=auto
CLAIMS_SILVER_ADJUDICATION_HERMES_EXECUTION_MODE=agent

# File-agent comparison and canonical Silver construction. Choose each role model.
CLAIMS_SILVER_WORKFLOW_MODE=file-agent
CLAIMS_SILVER_FILE_AGENT_HARNESS=hermes-cli
CLAIMS_SILVER_FILE_AGENT_PROVIDER=openrouter
CLAIMS_SILVER_FILE_AGENT_COMPARISON_MODEL=
CLAIMS_SILVER_FILE_AGENT_CANONICALIZATION_MODEL=
CLAIMS_SILVER_FILE_AGENT_CANONICAL_AUDIT_MODEL=
CLAIMS_SILVER_FILE_AGENT_MAX_TURNS=30
CLAIMS_SILVER_FILE_AGENT_MAX_TOKENS=81920
CLAIMS_SILVER_FILE_AGENT_TIMEOUT=1800
CLAIMS_SILVER_FILE_AGENT_REQUIRE_DISTINCT_JUDGES=true
CLAIMS_SILVER_FILE_AGENT_FALLBACK=none

# Downstream limits and persistence.
CLAIMS_SILVER_PAPER_MAX_WORKERS=50
CLAIMS_SILVER_IMPORTANCE_MODEL=
CLAIMS_SILVER_IMPORTANCE_BATCH_SIZE=8
CLAIMS_SILVER_IMPORTANCE_MAX_TOKENS=81920
CLAIMS_SILVER_MAX_ELIGIBLE_CLAIMS_PER_MINER=1000
CLAIMS_SILVER_MAX_ADJUDICATION_CASES_PER_PAPER=1000
CLAIMS_SILVER_FILTER_BY_ASSESSMENT=false
CLAIMS_SILVER_PERSIST_CHUNK_SIZE=50
CLAIMS_SILVER_PERSIST_VOTE_CHUNK_SIZE=150
CLAIMS_SILVER_CONSOLIDATION_TOP_K=4

SUBNET_CLAIMS_PDF_READER=pdf-inspector
